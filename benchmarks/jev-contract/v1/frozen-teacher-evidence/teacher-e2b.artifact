{
  "model": "google/gemini-2.5-flash",
  "temperature": 0,
  "max_tokens": 4096,
  "messages": [
    {
      "role": "system",
      "content": "You are the OpenClass Teacher. Your role is to improve versioned decision knowledge used by a bounded semantic decision provider called Jev. Jev is not a general planner, shell generator, safety authority, or source of ground truth. Jev chooses among a bounded set of semantic alternatives supplied by OpenClass. Measured characterization: Jev classifies robustly up to at least 32 concrete choices; it is degraded by abstract group descriptions, by anaphoric references to earlier decisions, and at the borderline between a plausible class and UNKNOWN. OpenClass executes only registered capabilities and independently verifies outcomes. A supplied failure diagnosis names the layer that failed. Do not change a working procedure to repair a routing problem. Do not change routing to hide an execution failure. Prefer the smallest reusable change supported by the evidence. Do not add literal aliases merely to memorize observations when the evidence supports a stable semantic concept; do not generalize beyond the evidence merely because abstraction seems elegant. Preserve known-good behavior. A candidate that gains coverage by regressing verified previous behavior will normally fail evaluation. Never invent executable shell, Python, paths, environment variables, credentials, or primitive names. You may only compose the registered primitives listed in the evidence. If the required operation is unavailable, return MISSING_CAPABILITY. Never assume model output is ground truth. Never activate your own proposal. Never claim human approval. Hidden evaluation cases are unavailable to you. If the evidence is insufficient, return INSUFFICIENT_EVIDENCE. Output only the supplied typed candidate schema."
    },
    {
      "role": "user",
      "content": "{\"diagnosis\": \"DECISION_SPACE\", \"question\": \"Add the routing choice for the newly registered recovery macro on node 'incident_commander'. Set target_id to the node id.\", \"registered_primitives\": [\"choose_available_test_port\", \"set_environment\", \"run_tests\", \"inspect_result\", \"write_report\", \"restart_dependency\"], \"primitive_signatures\": {\"choose_available_test_port\": {\"preferred\": \"int\"}, \"set_environment\": {\"name\": \"string\"}, \"run_tests\": {}, \"inspect_result\": {}, \"write_report\": {}, \"restart_dependency\": {}}, \"current_choices\": [{\"id\": \"execute_recovery\", \"description\": \"Run the registered recovery macro when tests fail because their required network port is already occupied.\"}, {\"id\": \"check_result\", \"description\": \"Look at the recorded test output before acting further.\"}], \"state\": {\"service\": \"queue-service\", \"port_conflict\": false, \"expected_env_var\": \"TEST_PORT\", \"dependency_down\": true}, \"allowed_operators\": [\"ADD_CHOICE\", \"GENERALIZE_CHOICE\", \"SPLIT_CHOICE\", \"MERGE_CHOICES\", \"ADD_DECISION_NODE\", \"RESTRUCTURE_NODE\", \"ADD_MACRO\", \"ADD_MACRO_BRANCH\", \"DEPRECATE_MACRO\", \"ADD_STATE_FEATURE\", \"ADD_NORMALIZER\", \"CHANGE_PRECONDITION\", \"CHANGE_POSTCONDITION\", \"MISSING_CAPABILITY\", \"NO_CHANGE\", \"INSUFFICIENT_EVIDENCE\"], \"base_policy_id\": \"decision-graph-proof\", \"registered_macros\": [\"recover_from_port_conflict\", \"restart_dependency_macro\"]}"
    }
  ],
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "teacher_candidate",
      "strict": true,
      "schema": {
        "$defs": {
          "Choice": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9_]{0,79}$",
                "title": "Id",
                "type": "string"
              },
              "semantic_name": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Semantic Name",
                "type": "string"
              },
              "description": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Description",
                "type": "string"
              },
              "target_node": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Target Node"
              },
              "target_macro": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Target Macro"
              }
            },
            "required": [
              "id",
              "semantic_name",
              "description"
            ],
            "title": "Choice",
            "type": "object"
          },
          "Macro": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9_]{0,79}$",
                "title": "Id",
                "type": "string"
              },
              "semantic_purpose": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Semantic Purpose",
                "type": "string"
              },
              "preconditions": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Predicate"
                },
                "title": "Preconditions",
                "type": "array"
              },
              "safety_guards": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Predicate"
                },
                "title": "Safety Guards",
                "type": "array"
              },
              "procedure": {
                "items": {
                  "$ref": "#/$defs/MacroStep"
                },
                "maxItems": 32,
                "minItems": 1,
                "title": "Procedure",
                "type": "array"
              },
              "postconditions": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Predicate"
                },
                "title": "Postconditions",
                "type": "array"
              }
            },
            "required": [
              "id",
              "semantic_purpose",
              "procedure"
            ],
            "title": "Macro",
            "type": "object"
          },
          "MacroStep": {
            "additionalProperties": false,
            "properties": {
              "primitive": {
                "pattern": "^[a-z][a-z0-9_]{0,79}$",
                "title": "Primitive",
                "type": "string"
              },
              "args": {
                "type": "object",
                "properties": {
                  "preferred": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "preferred",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "primitive"
            ],
            "title": "MacroStep",
            "type": "object"
          },
          "Predicate": {
            "additionalProperties": false,
            "description": "Deterministic state predicate; never model-evaluated.",
            "properties": {
              "field": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Field",
                "type": "string"
              },
              "equals": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Equals"
              }
            },
            "required": [
              "field",
              "equals"
            ],
            "title": "Predicate",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Typed evolution envelope; sections must match the declared operator.",
        "properties": {
          "candidate_type": {
            "enum": [
              "ADD_CHOICE",
              "GENERALIZE_CHOICE",
              "SPLIT_CHOICE",
              "MERGE_CHOICES",
              "ADD_DECISION_NODE",
              "RESTRUCTURE_NODE",
              "ADD_MACRO",
              "ADD_MACRO_BRANCH",
              "DEPRECATE_MACRO",
              "ADD_STATE_FEATURE",
              "ADD_NORMALIZER",
              "CHANGE_PRECONDITION",
              "CHANGE_POSTCONDITION",
              "MISSING_CAPABILITY",
              "NO_CHANGE",
              "INSUFFICIENT_EVIDENCE"
            ],
            "title": "Candidate Type",
            "type": "string"
          },
          "target_id": {
            "default": "",
            "title": "Target Id",
            "type": "string"
          },
          "macro": {
            "anyOf": [
              {
                "$ref": "#/$defs/Macro"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "choice": {
            "anyOf": [
              {
                "$ref": "#/$defs/Choice"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "semantic_description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Semantic Description",
            "type": "string"
          },
          "rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "base_policy_id": {
            "title": "Base Policy Id",
            "type": "string"
          }
        },
        "required": [
          "candidate_type",
          "semantic_description",
          "rationale",
          "confidence",
          "base_policy_id"
        ],
        "title": "TeacherCandidate",
        "type": "object"
      }
    }
  }
}
