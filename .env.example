# Development-only local database credentials. Compose reads this file after copying to .env.
OPENCLASS_DB_PASSWORD=openclass
OPENCLASS_DB_PORT=5432
OPENCLASS_PORT=7331
# Native Python processes read environment variables (not .env automatically).
# OPENCLASS_DATABASE_URL=postgresql+asyncpg://openclass:openclass@localhost:5432/openclass
# OPENCLASS_NOVELTY__STRONG_UNKNOWN_THRESHOLD=0.7
# OPENCLASS_SERVER_URL=http://localhost:7331

# Providers remain mock unless explicitly selected. Never commit real keys.
OPENCLASS_DECISION_PROVIDER=mock
OPENCLASS_SUPERVISOR_PROVIDER=mock
OPENCLASS_JEV_API_KEY=
OPENCLASS_JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
OPENCLASS_JEV_MODEL=typesafe-ai/jev
OPENCLASS_PROVIDER_TIMEOUT_SECONDS=20
OPENCLASS_PROVIDER_MAX_RETRIES=0

# Discovery is mock by default. Set GLM credentials only for the opt-in discovery slice.
OPENCLASS_DISCOVERY_PROVIDER=mock
OPENCLASS_GLM_API_KEY=
OPENCLASS_GLM_BASE_URL=https://api.z.ai/api/paas/v4
OPENCLASS_GLM_MODEL=glm-5.3-flash
OPENCLASS_DISCOVERY_API_KEY=
OPENCLASS_DISCOVERY_BASE_URL=
OPENCLASS_DISCOVERY_MODEL=alibaba/qwen-3-32b
OPENCLASS_DISCOVERY_TIMEOUT_SECONDS=30
