{
  "name": "openclass-workspace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "apps/portal",
    "apps/web",
    "services/control-plane",
    "packages/sdk-typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @openclass/portal dev",
    "dev:portal": "pnpm --filter @openclass/portal dev",
    "dev:control-plane": "pnpm --filter @openclass/control-plane start:dev",
    "seed:portal-phase-2": "uv run python scripts/seed_portal_phase_02.py",
    "seed:portal-phase-3": "uv run python scripts/seed_portal_phase_03.py",
    "seed:portal-phase-4": "uv run python scripts/seed_portal_phase_04.py",
    "seed:portal-phase-5": "uv run python scripts/seed_portal_phase_05.py",
    "seed:portal-phase-6": "uv run python scripts/seed_portal_phase_06.py",
    "seed:portal-phase-7": "uv run python scripts/seed_portal_phase_07.py",
    "seed:portal-phase-8": "uv run python scripts/seed_portal_phase_08.py",
    "seed:portal-phase-9": "uv run python scripts/seed_portal_phase_09.py",
    "seed:portal-phase-10": "uv run python scripts/seed_portal_phase_10.py",
    "seed:portal-phase-11": "uv run python scripts/seed_portal_phase_11.py",
    "seed:portal-phase-12": "uv run python scripts/seed_portal_phase_12.py",
    "seed:portal-phase-13": "uv run python scripts/seed_portal_phase_13.py",
    "seed:portal-phase-14": "uv run python scripts/seed_portal_phase_14.py",
    "seed:portal-phase-15": "uv run python scripts/seed_portal_phase_15.py",
    "seed:portal-phase-16": "uv run python scripts/seed_portal_phase_16.py",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --filter @openclass/control-plane --filter @openclass/portal --filter @openclass/sdk --filter @openclass/web test",
    "test:web": "playwright test --project=desktop --project=mobile",
    "test:web:live": "node scripts/live_stack/run.mjs",
    "test:delivery": "node --test scripts/live_stack/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
